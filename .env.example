# Sao chép tệp này thành .env nếu muốn thay đổi cấu hình demo.
KAFKA_EXTERNAL_PORT=9092
IOT_SOURCE_PORT=8101

# Bốn kịch bản: normal | rush_hour | rain | incident
IOT_SCENARIO=normal
IOT_INTERVAL_SECONDS=1
IOT_INCIDENT_DURATION_SECONDS=30
IOT_RANDOM_SEED=2026
AI_RESULT_STALE_SECONDS=12

# Nguồn video chạy ở terminal riêng; website dashboard dùng cổng 3000 và API 8102.
VIDEO_SOURCE_PORT=8102
NEXT_PUBLIC_VIDEO_API_URL=http://localhost:8102
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VIDEO_ROAD_ID=video-camera-01
VIDEO_ROAD_NAME=Nguồn video trực tiếp
VIDEO_LATITUDE=10.7732
VIDEO_LONGITUDE=106.7035
VIDEO_PUBLISH_INTERVAL_SECONDS=1
VIDEO_WARMUP_FRAMES=30
VIDEO_MIN_AREA_RATIO=0.0008
VIDEO_PIXELS_PER_METER=8
VIDEO_MAX_UPLOAD_MB=2048
VIDEO_DETECTOR=yolo
VIDEO_YOLO_MODEL=yolo26n.pt
VIDEO_YOLO_DEVICE=auto
VIDEO_YOLO_CONFIDENCE=0.12
VIDEO_YOLO_IMAGE_SIZE=640
VIDEO_JPEG_QUALITY=60
VIDEO_FRAME_MAX_WIDTH=960
VIDEO_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
